#include <stdio.h>

int main() {
    int m[4][4];
    for (int l = 0; l < 4; l++) {
        for (int c = 0; c < 4; c++) {
            scanf("%d", &m[l][c]);
        }
    }
    for (int l = 0; l < 4; l++) {
        int maior = m[l][0];
        for (int c = 1; c < 4; c++) {
            if (m[l][c] > maior) maior = m[l][c];
        }
        printf("%d\n", maior);
    }
    return 0;
}  




